NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional, default-off anonymous entry. Enable only with Supabase anonymous Auth
# and host-side anti-abuse controls configured.
NEXT_PUBLIC_FINANCE_GUEST_DEMO=false
# Optional configured event/run shortcuts. RLS still validates access.
NEXT_PUBLIC_FINANCE_ORGANIZATION_ID=
NEXT_PUBLIC_FINANCE_RUN_ID=
# Server only. HTTPS backend origin, or loopback HTTP for local development.
# The Google Gmail OAuth callback is handled by this backend, separately from dashboard auth.
FINANCE_API_URL=
