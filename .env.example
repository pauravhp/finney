# Public project identity; keep actual secret values out of source control.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallback only. Prefer sb_secret_* above.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
FINANCE_ORGANIZATION_ID=
FINANCE_RUN_ID=
FINANCE_EVENT_TIMEZONE=America/Vancouver
FINANCE_MODEL=claude-sonnet-4-6
FINANCE_MODEL_BASE_URL=https://api.anthropic.com/v1
FINANCE_MODEL_API_MODE=anthropic_messages
FINANCE_MODEL_API_KEY=
AI_GATEWAY_API_KEY=
FINANCE_HERMES_SOURCE=
FINANCE_HERMES_PYTHON=
# Mailbox access uses the isolated Hermes runtime by default.
FINANCE_GMAIL_BACKEND=hermes
# These three variables apply only to the optional legacy API/web OAuth path.
# Dashboard email/password uses Supabase Auth and needs no Google SSO credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8767/oauth/gmail/callback
FINANCE_TOKEN_ENCRYPTION_KEY=
# Use a dedicated label for personal-mailbox tests.
FINANCE_GMAIL_QUERY=label:director-finance
COINBASE_MCP_URL=
# For remote setup, use your deployed Finney callback; local setup may use the default.
COINBASE_REDIRECT_URI=http://127.0.0.1:8768/oauth/coinbase/callback
# Optional legacy bearer. Normal coinbase-connect stores its grant encrypted in Supabase.
COINBASE_MCP_TOKEN=
COINBASE_SENDER_ADDRESS=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
COINBASE_MAX_TEST_USDC_BASE_UNITS=100000000
X402_PAY_TO_ADDRESS=
X402_PRICE_BASE_UNITS=10000
X402_FACILITATOR_URL=https://x402.org/facilitator
FINANCE_PAYMENT_NETWORK=eip155:84532
FINANCE_TESTNET_ONLY=true
FINANCE_WORKER_ID=finance-worker
FINANCE_POLL_SECONDS=3
# Background worker only: automatic scoped Gmail intake at startup/every 60s.
FINANCE_AUTO_INTAKE_ENABLED=true
FINANCE_AUTO_INTAKE_BATCH_SIZE=20
FINANCE_STATE_DIR=.state
